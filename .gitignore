# Original game data and installers — never commit
*.exe
*.bin
*.EXE
*.dll
*.DLL
/extracted/
/ghidra/
/logs/
/build/
/target/
/export/
__pycache__/
# Lifted code is generated from the game binaries (tools/lift.sh) and stays local.
s4/lifted/*/src/
s3/lifted/*/src/
!s4/lifted/all/src/
s4/x86test/src/cases.rs*
*.log

# Synthetic clean-room test vectors (generated, no game data)
!s4/formats-clean/vectors/data/*.bin
